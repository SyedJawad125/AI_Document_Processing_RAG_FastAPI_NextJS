# ── App ───────────────────────────────
APP_NAME=AI Document Processing System
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-random-secret-key-here

# ── Database (LOCAL — not Docker) ─────
POSTGRES_DB=document_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost          ← change from 'db' to 'localhost'
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/document_ai
SYNC_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/document_ai

# ── Groq ──────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings ────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── RAG ───────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
RELEVANCE_THRESHOLD=0.3

# ── LangGraph ─────────────────────────
USE_AGENT_MODE=True
MAX_AGENT_ITERATIONS=5
AGENT_TIMEOUT=120
GRADING_THRESHOLD=0.6
ENABLE_QUERY_REWRITE=True

# ── Files ─────────────────────────────
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_FILE_SIZE_MB=20
LOG_LEVEL=INFO